# Credenciais do Telegram (obtenha em https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=seu_api_hash_aqui

# Palavras-chave para buscar (separadas por vírgula, sem distinção de maiúsculas/minúsculas)
KEYWORDS=rtx,iphone,playstation,promocao

# Palavras-chave excludentes: se qualquer uma aparecer na mensagem, o alerta é cancelado
# mesmo que uma KEYWORD acima tenha batido. Ex.: quer "iphone" mas não "iphone usado".
EXCLUDE_KEYWORDS=usado,reembalado

# Canais para monitorar (Usernames sem o @ ou IDs, separados por vírgula. Se deixar vazio, monitora TODOS os canais que você segue)
CHANNELS=canal_de_ofertas_exemplo,outro_canal
